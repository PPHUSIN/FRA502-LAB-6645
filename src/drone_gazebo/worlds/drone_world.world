<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="aerodynamics_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- FIXED: More stable physics settings for joint control -->
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.01</max_step_size>         <!-- FIXED: Changed from 0.001 to 0.01 -->
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>  <!-- FIXED: Changed from 1000 to 100 -->
      
      <!-- ADDED: ODE-specific settings for better joint control -->
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Keep your aerodynamics settings -->
    <atmosphere type="adiabatic">
      <temperature>298.15</temperature>
      <pressure>101325</pressure>
      <temperature_gradient>-0.0065</temperature_gradient>
    </atmosphere>

    <!-- OPTIONAL: Wind plugin - can be enabled later after joint control is working -->
    <!-- Commented out for joint control testing -->
    <!--
    <plugin name="wind_plugin" filename="libgazebo_ros_wind.so">
      <command_topic>cmd_wind</command_topic> 
      <ros>
        <namespace>/world</namespace>
      </ros>
    </plugin>
    -->

  </world>
</sdf>
