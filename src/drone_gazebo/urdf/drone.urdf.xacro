<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Thrut_Vectoring_Drone">

    <xacro:property name="body_mass" value="0.8"/>
    <xacro:property name="fin_mass" value="0.006"/>
    <xacro:property name="package_name" value="drone_gazebo"/>

    <xacro:macro name="box_inertia" params="m x y z">
        <inertial>
            <mass value="${m}"/>
            <inertia ixx="${(m/12) * (y*y + z*z)}" ixy="0.0" ixz="0.0" iyy="${(m/12) * (x*x + z*z)}" iyz="0.0" izz="${(m/12) * (x*x + y*y)}"/>
        </inertial>
    </xacro:macro>

    <link name="base_link"></link>

    <joint name="base_to_body_joint" type="fixed">
        <parent link="base_link"/>
        <child link="body_drone"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="body_drone">
        <visual>
            <origin xyz="-0.0625 0.0625 0.0" rpy="1.5708 0 0"/>
            <geometry>
                <mesh filename="$(find drone_gazebo)/component/drviz.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="red">
                <color rgba="0.8 0.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.15 0.15 0.15"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${body_mass}"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.02"/>
        </inertial>
    </link>

    <gazebo reference="body_drone">
        <material>Gazebo/Red</material>
    </gazebo>

    <link name="fin_1">
        <visual>
            <origin xyz="-0.0116 -0.00575 -0.025" rpy="0 0 0"/>
            <geometry>
                <mesh filename="$(find drone_gazebo)/component/fin_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black">
                <color rgba="1.0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.01 0.08"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="${fin_mass}" x="0.05" y="0.01" z="0.08"/>
    </link>

    <joint name="fin_1_joint" type="revolute">
        <parent link="body_drone"/>
        <child link="fin_1"/>
        <origin xyz="0.029 0.0 0.048" rpy="0 1.5708 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="10"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <gazebo reference="fin_1">
        <material>Gazebo/Black</material>
    </gazebo>

    <link name="fin_2">
        <visual>
            <origin xyz="-0.0116 -0.00575 -0.025" rpy="0 0 0"/>
            <geometry>
                <mesh filename="$(find drone_gazebo)/component/fin_2.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black">
                <color rgba="1.0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.01 0.08"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="${fin_mass}" x="0.05" y="0.01" z="0.08"/>
    </link>

    <joint name="fin_2_joint" type="revolute">
        <parent link="body_drone"/>
        <child link="fin_2"/>
        <origin xyz="-0.029 0.0 0.048" rpy="0 1.5708 3.14"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="10"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <gazebo reference="fin_2">
        <material>Gazebo/Black</material>
    </gazebo>

    <link name="fin_3">
        <visual>
            <origin xyz="-0.0116 -0.00575 -0.025" rpy="0 0 0"/>
            <geometry>
                <mesh filename="$(find drone_gazebo)/component/fin_3.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black">
                <color rgba="1.0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.01 0.08"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="${fin_mass}" x="0.05" y="0.01" z="0.08"/>
    </link>

    <joint name="fin_3_joint" type="revolute">
        <parent link="body_drone"/>
        <child link="fin_3"/>
        <origin xyz="0.0 0.029 0.048" rpy="-1.5708 1.5708 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="10"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <gazebo reference="fin_3">
        <material>Gazebo/Black</material>
    </gazebo>

    <link name="fin_4">
        <visual>
            <origin xyz="-0.0116 -0.00575 -0.025" rpy="0 0 0"/>
            <geometry>
                <mesh filename="$(find drone_gazebo)/component/fin_4.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black">
                <color rgba="1.0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.01 0.08"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="${fin_mass}" x="0.05" y="0.01" z="0.08"/>
    </link>

    <joint name="fin_4_joint" type="revolute">
        <parent link="body_drone"/>
        <child link="fin_4"/>
        <origin xyz="0.0 -0.029 0.048" rpy="1.5708 1.5708 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="10"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <gazebo reference="fin_4">
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo>
        <plugin name="fin_1_aerodynamics" filename="libLiftDragPlugin.so">
            <a0>0.05</a0>
            <cla>4.0</cla>
            <cda>0.01</cda>
            <cma>0.00</cma>
            <alpha_stall>0.6</alpha_stall>
            <cla_stall>-0.2</cla_stall>
            <cda_stall>1.0</cda_stall>
            <cp>0 0 0</cp>
            <area>0.004</area>
            <air_density>1.2041</air_density>
            <forward>1 0 0</forward>
            <upward>0 0 1</upward>
            <link_name>fin_1</link_name>
        </plugin>

        <plugin name="fin_2_aerodynamics" filename="libLiftDragPlugin.so">
            <a0>0.05</a0>
            <cla>4.0</cla>
            <cda>0.01</cda>
            <cma>0.00</cma>
            <alpha_stall>0.6</alpha_stall>
            <cla_stall>-0.2</cla_stall>
            <cda_stall>1.0</cda_stall>
            <cp>0 0 0</cp>
            <area>0.004</area>
            <air_density>1.2041</air_density>
            <forward>1 0 0</forward>
            <upward>0 0 1</upward>
            <link_name>fin_2</link_name>
        </plugin>

        <plugin name="fin_3_aerodynamics" filename="libLiftDragPlugin.so">
            <a0>0.05</a0>
            <cla>4.0</cla>
            <cda>0.01</cda>
            <cma>0.00</cma>
            <alpha_stall>0.6</alpha_stall>
            <cla_stall>-0.2</cla_stall>
            <cda_stall>1.0</cda_stall>
            <cp>0 0 0</cp>
            <area>0.004</area>
            <air_density>1.2041</air_density>
            <forward>1 0 0</forward>
            <upward>0 0 1</upward>
            <link_name>fin_3</link_name>
        </plugin>

        <plugin name="fin_4_aerodynamics" filename="libLiftDragPlugin.so">
            <a0>0.05</a0>
            <cla>4.0</cla>
            <cda>0.01</cda>
            <cma>0.00</cma>
            <alpha_stall>0.6</alpha_stall>
            <cla_stall>-0.2</cla_stall>
            <cda_stall>1.0</cda_stall>
            <cp>0 0 0</cp>
            <area>0.004</area>
            <air_density>1.2041</air_density>
            <forward>1 0 0</forward>
            <upward>0 0 1</upward>
            <link_name>fin_4</link_name>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin name="gazebo_ros_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
            <update_rate>50</update_rate>
            <joint_name>fin_1_joint</joint_name>
            <joint_name>fin_2_joint</joint_name>
            <joint_name>fin_3_joint</joint_name>
            <joint_name>fin_4_joint</joint_name>
        </plugin>

        <plugin name="gazebo_ros_force" filename="libgazebo_ros_force.so">
            <ros>
                <namespace>/drone</namespace>
                <remapping>gazebo_ros_force:=thrust</remapping>
            </ros>
            <link_name>base_link</link_name>
            <force_frame>link</force_frame>
        </plugin>

        <plugin name="drone_fin_1_controller" filename="libgazebo_ros_joint_position_controller.so">
            <ros>
                <namespace>/drone</namespace>
                <remapping>joint_position_controller:=fin_1/position</remapping>
            </ros>
            <joint_name>fin_1_joint</joint_name>
            <pid_gain>100 1 10</pid_gain>
            <initial_velocity>0.0</initial_velocity>
        </plugin>

        <plugin name="drone_fin_2_controller" filename="libgazebo_ros_joint_position_controller.so">
            <ros>
                <namespace>/drone</namespace>
                <remapping>joint_position_controller:=fin_2/position</remapping>
            </ros>
            <joint_name>fin_2_joint</joint_name>
            <pid_gain>100 1 10</pid_gain>
            <initial_velocity>0.0</initial_velocity>
        </plugin>

        <plugin name="drone_fin_3_controller" filename="libgazebo_ros_joint_position_controller.so">
            <ros>
                <namespace>/drone</namespace>
                <remapping>joint_position_controller:=fin_3/position</remapping>
            </ros>
            <joint_name>fin_3_joint</joint_name>
            <pid_gain>100 1 10</pid_gain>
            <initial_velocity>0.0</initial_velocity>
        </plugin>

        <plugin name="drone_fin_4_controller" filename="libgazebo_ros_joint_position_controller.so">
            <ros>
                <namespace>/drone</namespace>
                <remapping>joint_position_controller:=fin_4/position</remapping>
            </ros>
            <joint_name>fin_4_joint</joint_name>
            <pid_gain>100 1 10</pid_gain>
            <initial_velocity>0.0</initial_velocity>
        </plugin>

        <plugin name="p3d_base_controller" filename="libgazebo_ros_p3d.so">
            <ros>
                <remapping>odom:=/odom</remapping>
            </ros>
            <body_name>base_link</body_name>
            <frame_name>world</frame_name>
            <update_rate>100.0</update_rate>
            <xyz_offset>0 0 0</xyz_offset>
            <rpy_offset>0 0 0</rpy_offset>
            <gaussian_noise>0.00</gaussian_noise>
        </plugin>

    </gazebo>

</robot>
