<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Thrut_Vectoring_Drone">

    <link name="base_link">
    </link>

    <joint name="base_to_body_joint" type="fixed">
        <parent link="base_link"/>
        <child link="body_drone"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <material name="black">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>
    <material name="red">
        <color rgba="0.8 0.0 0.0 1.0"/>
    </material>

    <link name="body_drone">
        <visual>
        <origin xyz="-0.0625 0.0625 0.0" rpy="1.5708 0 0"/>
            <geometry>
                <mesh filename="package://drone/component/drviz.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="red"/>
        </visual>        
    </link>

    <link name="fin_1">
        <visual>
            <origin xyz="-0.0116 -0.00575 -0.025" rpy="0 0 0"/> 
            <geometry>
                <mesh filename="package://drone/component/fin_1.stl" scale="0.001 0.001 0.001"/>
            </geometry> 
            <material name="black"/>           
        </visual>        
    </link>

    <joint name="fin_1_joint" type="revolute"> 
        <parent link="body_drone"/>
        <child link="fin_1"/>
        
        <origin xyz="0.0325 0.0 0.0425" rpy="0 1.5708 0"/>
        
        <axis xyz="0 0 1"/> 
        <limit lower="-1.57" upper="1.57" effort="10" velocity="10"/> 
    </joint>

    <link name="fin_2">
        <visual>
            <origin xyz="-0.0116 -0.00575 -0.025" rpy="0 0 0"/> 
            <geometry>
                <mesh filename="package://drone/component/fin_2.stl" scale="0.001 0.001 0.001"/>
            </geometry> 
            <material name="black"/> 
        </visual>        
    </link>

    <joint name="fin_2_joint" type="revolute"> 
        <parent link="body_drone"/>
        <child link="fin_2"/>
        
        <origin xyz="-0.0325 0.0 0.0425" rpy="0 1.5708 3.14"/>
        
        <axis xyz="0 0 1"/> 
        <limit lower="-1.57" upper="1.57" effort="10" velocity="10"/> 
    </joint>

    <link name="fin_3">
        <visual>
            <origin xyz="-0.0116 -0.00575 -0.025" rpy="0 0 0"/> 
            <geometry>
                <mesh filename="package://drone/component/fin_3.stl" scale="0.001 0.001 0.001"/>
            </geometry> 
            <material name="black"/>           
        </visual>        
    </link>

    <joint name="fin_3_joint" type="revolute"> 
        <parent link="body_drone"/>
        <child link="fin_3"/>
        
        <origin xyz="0.0 0.0325 0.0425" rpy="-1.5708 1.5708 0"/>
        
        <axis xyz="0 0 1"/> 
        <limit lower="-1.57" upper="1.57" effort="10" velocity="10"/> 
    </joint>

    <link name="fin_4">
        <visual>
            <origin xyz="-0.0116 -0.00575 -0.025" rpy="0 0 0"/> 
            <geometry>
                <mesh filename="package://drone/component/fin_4.stl" scale="0.001 0.001 0.001"/>
            </geometry> 
            <material name="black"/>           
        </visual>        
    </link>

    <joint name="fin_4_joint" type="revolute"> 
        <parent link="body_drone"/>
        <child link="fin_4"/>
        
        <origin xyz="0.0 -0.0325 0.0425" rpy="1.5708 1.5708 0"/>
        
        <axis xyz="0 0 1"/> 
        <limit lower="-1.57" upper="1.57" effort="10" velocity="10"/> 
    </joint>

</robot>